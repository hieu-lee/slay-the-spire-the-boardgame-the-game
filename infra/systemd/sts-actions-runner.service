[Unit]
Description=Slay the Spire GitHub Actions runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/actions-runner
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Environment=LD_LIBRARY_PATH=%h/.local/share/actions-runner/_localdeps/usr/lib/x86_64-linux-gnu
ExecStart=%h/.local/share/actions-runner/run.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
