node_modules/
dist/

# The publisher's rulebook, kept locally as ground truth but not redistributed.
# docs/rules.md records where to fetch it.
docs/reference/
tmp/
*.tsbuildinfo

# src/ is TypeScript only. A stray `tsc` (without -b, or with --noEmit false)
# drops compiled siblings next to the sources, which Vite will happily resolve
# ahead of the .ts file and which must never be committed.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
.DS_Store
.rooms/

# Review subagents occasionally drop scratch files in the repo root despite
# being told not to. Keep them out of commits.
/test-*.mjs
/scratch-*.mjs
/tmp-*.mjs
# ...and downloaded scans, which have landed here more than once.
/*.png
/*.jpg
/*.webp
artifacts/

# All artwork is the publisher's. It is fetched into the working tree by the
# sync-* scripts and deliberately NOT redistributed here. See ATTRIBUTION.md.
public/assets/cards/
public/assets/cards-hd/
public/assets/icons/
public/assets/enemies/
