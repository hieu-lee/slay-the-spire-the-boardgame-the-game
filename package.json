{
  "name": "slay-the-spire-boardgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "dev:rooms": "node scripts/room-server.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:5180",
    "play": "pnpm run --parallel \"/^(dev|dev:rooms|tunnel)$/\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-all.mjs",
    "verify:changed": "node scripts/verify-all.mjs --changed",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:end-turn-drag": "node scripts/verify-end-turn-drag-browser.mjs",
    "verify:online": "node scripts/verify-online-browser.mjs",
    "verify:single-player-build": "node scripts/check-single-player-build.mjs && pnpm exec playwright install chromium && node scripts/verify-single-player-unlocks-browser.mjs",
    "sync:assets": "node scripts/sync-card-assets.mjs && node scripts/sync-icons.mjs && node scripts/sync-enemy-art.mjs",
    "sync:cards": "node scripts/sync-card-assets.mjs",
    "sync:downfall-cards": "node scripts/sync-downfall-card-assets.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:enemy-art": "node scripts/sync-enemy-art.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.5",
    "playwright": "1.60.0"
  }
}
